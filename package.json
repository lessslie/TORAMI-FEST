{
  "name": "torami-fest",
  "version": "1.0.0",
  "description": "Torami Fest - Event Management Platform",
  "private": true,
  "scripts": {
    "prepare": "husky",
    "test:back": "cd back && npm test",
    "lint:back": "cd back && npm run lint",
    "build:back": "cd back && npm run build",
    "build:front": "cd front && npm run build"
  },
  "devDependencies": {
    "husky": "^9.0.11",
    "lint-staged": "^15.2.2"
  },
  "lint-staged": {
    "back/**/*.ts": [
      "cd back && npm run lint -- --fix"
    ]
  },
  "dependencies": {
    "openai": "^6.15.0"
  }
}
